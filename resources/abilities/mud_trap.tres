script = ExtResource("1_ability")
display_name = "Mud Trap"
description = "Hides a mud trap where the Mirelurk stands (up to 3). The first enemy to step on it springs it: enemies nearby are damaged and rooted for 2.5s. They are poisoned too, for 5s."
