[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="Level" type="Node" parent="."]

[node name="LevelSpawner" type="MultiplayerSpawner" parent="."]
_spawnable_scenes = PackedStringArray("res://scenes/world.tscn")
spawn_path = NodePath("../Level")
spawn_limit = 1

[node name="MenuLayer" type="CanvasLayer" parent="."]

[node name="Menu" type="PanelContainer" parent="MenuLayer"]
unique_name_in_owner = true
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -170.0
offset_right = 220.0
offset_bottom = 170.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="MenuLayer/Menu"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="MenuLayer/Menu/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="MenuLayer/Menu/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Pack Leader"
horizontal_alignment = 1

[node name="NameEdit" type="LineEdit" parent="MenuLayer/Menu/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Your name"
text = "Tamer"
max_length = 16

[node name="AddressEdit" type="LineEdit" parent="MenuLayer/Menu/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Host address"
text = "127.0.0.1"

[node name="Buttons" type="HBoxContainer" parent="MenuLayer/Menu/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HostButton" type="Button" parent="MenuLayer/Menu/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Host"

[node name="JoinButton" type="Button" parent="MenuLayer/Menu/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Join"

[node name="StatusLabel" type="Label" parent="MenuLayer/Menu/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Host a game, or join one by IP (port 24565)."
horizontal_alignment = 1
autowrap_mode = 3
